{
  "name": "ecommerce-platform-api",
  "version": "1.0.0",
  "description": "Production-grade Cloud Deployment & CI/CD E-Commerce Platform API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "lint": "eslint src tests server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js"
  },
  "keywords": [
    "ecommerce",
    "devops",
    "cicd",
    "docker",
    "kubernetes",
    "prometheus",
    "observability"
  ],
  "author": "DevOps & Cloud Engineering Candidate",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.4",
    "selfsigned": "^5.5.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
