# ====================================================================
# E-Commerce Platform API - Environment Configuration Template
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL
# Copy this file to .env before starting the application
# ====================================================================

# Runtime Environment
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# Administrative Security
# Required header: X-Admin-Token or Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=algions-admin-secret-key-2026

# Database Connection (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass_2026
DB_NAME=ecommerce_db
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Automated Migration on Bootstrap
AUTO_MIGRATE=true

# Observability & Metrics
ENABLE_METRICS=true

# Container Orchestration Port Binds (Optional overrides)
API_PORT_BIND=127.0.0.1:3000
DB_PORT_BIND=127.0.0.1:5433
IMAGE_TAG=latest
